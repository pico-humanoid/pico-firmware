{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build internal loopback",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Mode",
        "Loopback"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$gcc"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/linux/build.sh",
          "Loopback"
        ]
      }
    },
    {
      "label": "Build external CAN",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/build.ps1",
        "-Mode",
        "External"
      ],
      "group": {
        "kind": "build",
        "isDefault": false
      },
      "problemMatcher": [
        "$gcc"
      ],
      "linux": {
        "command": "bash",
        "args": [
          "${workspaceFolder}/scripts/linux/build.sh",
          "External"
        ]
      }
    }
  ]
}
